rules_version = '2';
// Reglar for både Premiejakt (quizpremiar) og Etnequizen. Lim inn heile fila under Firestore > Reglar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Innlogga med stadfesta e-post (Google-konto eller innloggingslenkje)
    function epost() { return request.auth.token.email.lower(); }
    function innlogga() { return request.auth != null && request.auth.token.email_verified == true; }
    function tilgangDoc() { return /databases/$(database)/documents/tilgang/$(epost()); }
    function harTilgang() { return innlogga() && exists(tilgangDoc()); }
    function rolle() { return get(tilgangDoc()).data.rolle; }
    function kanEndre() { return harTilgang() && rolle() in ['admin', 'redaktor']; }
    function erAdmin() { return harTilgang() && rolle() == 'admin'; }

    // Aktørane: alle på lista kan lese, redaktørar og admin kan endre
    match /aktorar/{id} {
      allow read: if harTilgang();
      allow create, update: if kanEndre();
      allow delete: if kanEndre();
    }

    // Statusar og andre innstillingar
    match /config/{id} {
      allow read: if harTilgang();
      allow write: if kanEndre();
    }

    // Tilgangslista: berre admin kan endre kven som slepp inn
    match /tilgang/{e} {
      allow read: if harTilgang();
      allow write: if erAdmin();
    }

    // ---- Etnequizen (mstene.no/etnequiz) ----
    // Eiga tilgangsliste: ein dokument per e-post i etneTilgang, lagt inn frå Firebase-konsollen
    function etneAdmin() { return innlogga() && exists(/databases/$(database)/documents/etneTilgang/$(epost())); }

    match /etneTilgang/{e} {
      allow read: if innlogga() && e == epost();
      allow write: if false;
    }
    // Quizen og kva storskjermen viser no
    match /etne/{doc} {
      allow read, write: if etneAdmin();
    }
    // Bilete til spørsmåla
    match /etneBilete/{id} {
      allow read, write: if etneAdmin();
    }
    // Laga og poenga deira
    match /etneLag/{id} {
      allow read, write: if etneAdmin();
    }

    // Alt anna er stengt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
