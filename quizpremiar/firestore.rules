rules_version = '2';
// Reglar for både Premiejakt (quizpremiar) og Etnequizen. Lim inn heile fila under Firestore > Reglar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Innlogga med stadfesta e-post (Google-konto eller innloggingslenkje)
    function epost() { return request.auth.token.email.lower(); }
    function innlogga() { return request.auth != null && request.auth.token.email_verified == true; }
    function tilgangDoc() { return /databases/$(database)/documents/tilgang/$(epost()); }
    function harTilgang() { return innlogga() && exists(tilgangDoc()); }
    function rolle() { return get(tilgangDoc()).data.rolle; }
    function kanEndre() { return harTilgang() && rolle() in ['admin', 'redaktor']; }
    function erAdmin() { return harTilgang() && rolle() == 'admin'; }

    // Aktørane: alle på lista kan lese, redaktørar og admin kan endre
    match /aktorar/{id} {
      allow read: if harTilgang();
      allow create, update: if kanEndre();
      allow delete: if kanEndre();
    }

    // Statusar og andre innstillingar
    match /config/{id} {
      allow read: if harTilgang();
      allow write: if kanEndre();
    }

    // Tilgangslista: berre admin kan endre kven som slepp inn
    match /tilgang/{e} {
      allow read: if harTilgang();
      allow write: if erAdmin();
    }

    // ---- Etnequizen (mstene.no/etnequiz) ----
    // Eiga tilgangsliste: ein dokument per e-post i etneTilgang, lagt inn frå Firebase-konsollen
    function etneAdmin() { return innlogga() && exists(/databases/$(database)/documents/etneTilgang/$(epost())); }

    match /etneTilgang/{e} {
      allow read: if innlogga() && e == epost();
      allow write: if false;
    }
    // Quizen og kva storskjermen viser no
    match /etne/{doc} {
      allow read, write: if etneAdmin();
    }
    // Bilete til spørsmåla
    match /etneBilete/{id} {
      allow read, write: if etneAdmin();
    }
    // Laga og poenga deira
    match /etneLag/{id} {
      allow read, write: if etneAdmin();
    }
    // ---- Etnequizen: lagsida på mobilen (QR-koden på bordet, anonym innlogging) ----
    // Hemmeleg kode per bord (står i QR-koden). Berre quizmasteren ser dei.
    match /etneKode/{bord} {
      allow read, write: if etneAdmin();
    }
    // Det lagsida får sjå: tittel, barmeny, lagnamn og om resultatet er ope
    match /etneLive/{doc} {
      allow read: if request.auth != null;
      allow write: if etneAdmin();
    }
    // Resultatet per bord. Dokument-id-en er «bord_kode», så berre dei som har skanna
    // QR-koden på bordet, kan opne det, og berre etter at quizmasteren har opna resultatet.
    match /etneResultat/{id} {
      allow get: if etneAdmin() || (request.auth != null
        && get(/databases/$(database)/documents/etneLive/no).data.get('resultat', false) == true);
      allow list, write: if etneAdmin();
    }

    // ---- Etnequizen med fleire quizar (mstene.no/etnequiz-ny) ----
    // Kvar quiz har si eiga mappe: etneQuiz/<quiz> er spørsmåla, og under ligg lag, kodar,
    // poenginnstillingar, det mobilane får sjå (offentleg/no) og resultata.
    function offentlegDoc(q) { return /databases/$(database)/documents/etneQuiz/$(q)/offentleg/no; }

    match /etneQuiz/{q} {
      allow read, write: if etneAdmin();
      // Lag, QR-kodar og poenginnstillingar: berre quizmasterane
      match /lag/{id} { allow read, write: if etneAdmin(); }
      match /kode/{id} { allow read, write: if etneAdmin(); }
      match /meta/{id} { allow read, write: if etneAdmin(); }
      // Det lagsida får sjå for denne quizen: tittel, barmeny, lagnamn og om resultat er ope
      match /offentleg/{id} {
        allow read: if request.auth != null;
        allow write: if etneAdmin();
      }
      // Resultatet per bord. Id-en er «bord_kode», så berre dei som har skanna QR-koden kan opne det,
      // og berre når quizmasteren har opna resultat for denne quizen (under eller etter quizen).
      match /resultat/{id} {
        allow get: if etneAdmin() || (request.auth != null && exists(offentlegDoc(q))
          && get(offentlegDoc(q)).data.get('ope', false) == true);
        allow list, write: if etneAdmin();
      }
    }

    // Alt anna er stengt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
