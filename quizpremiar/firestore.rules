rules_version = '2';
// Reglar for både Premiejakt (quizpremiar) og Etnequizen. Lim inn heile fila under Firestore > Reglar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Innlogga med stadfesta e-post (Google-konto eller innloggingslenkje)
    function epost() { return request.auth.token.email.lower(); }
    function innlogga() { return request.auth != null && request.auth.token.email_verified == true; }
    function tilgangDoc() { return /databases/$(database)/documents/tilgang/$(epost()); }
    function harTilgang() { return innlogga() && exists(tilgangDoc()); }
    function rolle() { return get(tilgangDoc()).data.rolle; }
    function kanEndre() { return harTilgang() && rolle() in ['admin', 'redaktor']; }
    function erAdmin() { return harTilgang() && rolle() == 'admin'; }

    // Aktørane: alle på lista kan lese, redaktørar og admin kan endre
    match /aktorar/{id} {
      allow read: if harTilgang();
      allow create, update: if kanEndre();
      allow delete: if kanEndre();
    }

    // Statusar og andre innstillingar
    match /config/{id} {
      allow read: if harTilgang();
      allow write: if kanEndre();
    }

    // Tilgangslista: berre admin kan endre kven som slepp inn
    match /tilgang/{e} {
      allow read: if harTilgang();
      allow write: if erAdmin();
    }

    // ---- Etnequizen (mstene.no/etnequiz) ----
    // Eiga tilgangsliste: ein dokument per e-post i etneTilgang, lagt inn frå Firebase-konsollen
    function etneAdmin() { return innlogga() && exists(/databases/$(database)/documents/etneTilgang/$(epost())); }

    match /etneTilgang/{e} {
      allow read: if innlogga() && e == epost();
      allow write: if false;
    }
    // Quizen og kva storskjermen viser no
    match /etne/{doc} {
      allow read, write: if etneAdmin();
    }
    // Bilete til spørsmåla
    match /etneBilete/{id} {
      allow read, write: if etneAdmin();
    }
    // Laga og poenga deira
    match /etneLag/{id} {
      allow read, write: if etneAdmin();
    }
    // ---- Etnequizen: lagsida på mobilen (QR-koden på bordet, anonym innlogging) ----
    // Hemmeleg kode per bord (står i QR-koden). Berre quizmasteren ser dei.
    match /etneKode/{bord} {
      allow read, write: if etneAdmin();
    }
    // Det lagsida får sjå: tittel, barmeny, lagnamn og om resultatet er ope
    match /etneLive/{doc} {
      allow read: if request.auth != null;
      allow write: if etneAdmin();
    }
    // Resultatet per bord. Dokument-id-en er «bord_kode», så berre dei som har skanna
    // QR-koden på bordet, kan opne det, og berre etter at quizmasteren har opna resultatet.
    match /etneResultat/{id} {
      allow get: if etneAdmin() || (request.auth != null
        && get(/databases/$(database)/documents/etneLive/no).data.get('resultat', false) == true);
      allow list, write: if etneAdmin();
    }

    // ---- Etnequizen med fleire quizar (mstene.no/etnequiz-ny) ----
    // Kvar quiz har si eiga mappe: etneQuiz/<quiz> er spørsmåla, og under ligg lag, kodar,
    // poenginnstillingar, det mobilane får sjå (offentleg/no) og resultata.
    function offentlegDoc(q) { return /databases/$(database)/documents/etneQuiz/$(q)/offentleg/no; }

    match /etneQuiz/{q} {
      allow read, write: if etneAdmin();
      // Lag, QR-kodar og poenginnstillingar: berre quizmasterane
      match /lag/{id} { allow read, write: if etneAdmin(); }
      match /kode/{id} { allow read, write: if etneAdmin(); }
      match /meta/{id} { allow read, write: if etneAdmin(); }
      // Det lagsida får sjå for denne quizen: tittel, barmeny, lagnamn og om resultat er ope
      match /offentleg/{id} {
        allow read: if request.auth != null;
        allow write: if etneAdmin();
      }
      // Resultatet per bord. Id-en er «bord_kode», så berre dei som har skanna QR-koden kan opne det,
      // og berre når quizmasteren har opna resultat for denne quizen (under eller etter quizen).
      match /resultat/{id} {
        allow get: if etneAdmin() || (request.auth != null && exists(offentlegDoc(q))
          && get(offentlegDoc(q)).data.get('ope', false) == true);
        allow list, write: if etneAdmin();
      }
    }

    // ---- Pubquiz-poeng (mstene.no/pubquiz) ----
    // Alle kan sjå resultat, sesongtabell og lagsider. Berre e-postar i pubTilgang kan endre.
    // Den første e-posten må leggjast inn frå Firebase-konsollen (dokument-id = e-post med små bokstavar).
    // quiz@ og alle <rolle>.quiz@samfunnetibergen.no-kontoar får tilgang automatisk (berre workspace-admin kan lage dei).
    function pubQuizKonto() { return epost().matches('^([a-z0-9._-]+[.])?quiz@samfunnetibergen[.]no$'); }
    function pubAdmin() { return innlogga() && (pubQuizKonto() || exists(/databases/$(database)/documents/pubTilgang/$(epost()))); }

    // Valfri PIN per lag. Står det teamId i påmeldinga og laget har PIN, må pinHash stemme.
    function pubPinDoc(t) { return /databases/$(database)/documents/pubPin/$(t); }
    function pubPinOk(d) {
      return !('teamId' in d) || (d.teamId is string
        && (!exists(pubPinDoc(d.teamId)) || (('pinHash' in d) && d.pinHash == get(pubPinDoc(d.teamId)).data.hash)));
    }

    match /pubTilgang/{e} {
      allow read: if innlogga() && (e == epost() || pubAdmin());
      allow write: if pubAdmin();
    }
    match /pubLag/{id} {
      allow read: if true;
      allow write: if pubAdmin();
    }
    match /pubVeke/{id} {
      allow read: if true;
      allow write: if pubAdmin();
    }
    match /pubConfig/{id} {
      allow read: if true;
      allow write: if pubAdmin();
    }
    // Påmelding frå QR-koden: kven som helst kan melde på eit lag, men berre når
    // quizmasteren har opna påmeldinga for den kvelden. Berre admin kan lese og slette.
    match /pubSignup/{id} {
      allow create: if request.resource.data.keys().hasOnly(['weekId', 'name', 'members', 'created', 'teamId', 'pinHash'])
        && request.resource.data.weekId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.members is int
        && request.resource.data.members >= 1 && request.resource.data.members <= 30
        && request.resource.data.created == request.time
        && get(/databases/$(database)/documents/pubVeke/$(request.resource.data.weekId)).data.get('signupOpen', false) == true
        && pubPinOk(request.resource.data);
      allow read, delete: if pubAdmin();
      allow update: if false;
    }
    // PIN-en (som SHA-256): kven som helst kan setje PIN på eit lag som ikkje har det,
    // saman med merket i pubHarPin. Berre admin kan lese hashen og fjerne PIN-en.
    match /pubPin/{id} {
      allow create: if exists(/databases/$(database)/documents/pubLag/$(id))
        && request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64
        && existsAfter(/databases/$(database)/documents/pubHarPin/$(id));
      allow read, delete: if pubAdmin();
      allow update: if false;
    }
    // Offentleg merke: «dette laget har PIN», så påmeldinga veit når ho skal spørje
    match /pubHarPin/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['created'])
        && request.resource.data.created == request.time
        && existsAfter(pubPinDoc(id));
      allow delete: if pubAdmin();
      allow update: if false;
    }

    // Alt anna er stengt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
